# ============================================================================
# Resuto — environment
#
#   cp .env.example .env      then fill in what you actually have.
#
# Everything below is OPTIONAL except the two passwords. With nothing else
# set the whole demo still runs: AI falls back to visibly-labelled demo rules,
# payments run in simulated test mode, and connectors show as "not configured".
# The interface always states which mode it is in — it never fakes a live
# integration.
# ============================================================================

# --- Core (required) --------------------------------------------------------
PORT=3000
APP_ORIGIN=http://localhost:3000
# Protects /manager, /kitchen and /host. Change these before any public deployment.
MANAGER_PASSWORD=change-this-manager-password
KITCHEN_PASSWORD=change-this-kitchen-password
# Protects /host — the front desk / door screen.
HOST_PASSWORD=change-this-host-password


# --- Google Gemini (AI features) -------------------------------------------
# Get a key: https://aistudio.google.com/apikey
# With a key set, these become live instead of demo rules:
#   • Menu assistant / AI ordering       (text model)
#   • AI menu import from PDF or photo   (vision model)
#   • AI floor extraction from a plan    (vision model)
#   • AI manager operational insights    (text model)
# Without a key every one of those still works, labelled "Demo rules".
GEMINI_API_KEY=

# One model for everything (simplest). Leave the per-capability lines empty.
GEMINI_MODEL=gemini-3.6-flash

# Optional per-capability overrides. Each falls back to GEMINI_MODEL.
GEMINI_TEXT_MODEL=
GEMINI_VISION_MODEL=
# Dish image generation stays OFF unless you name an image-capable model here.
GEMINI_IMAGE_MODEL=


# --- Payments ---------------------------------------------------------------
# test  = simulated ledger payments, nothing is charged (use this for the demo)
# live  = simulated payments are refused; real gateway credentials required
PAYMENT_MODE=test

# Stripe — hosted card checkout appears only once these are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Paymob — cards and mobile wallets for Egypt.
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=

# InstaPay — manual transfer, confirmed by the manager on the bill.
INSTAPAY_MERCHANT_ADDRESS=


# --- POS / back-office connectors (menu import only) ------------------------
# Imports produce a draft for manager review. Orders are never pushed back.
FOODICS_API_TOKEN=
ODOO_URL=
ODOO_API_KEY=
ODOO_DATABASE=
# Set EGP only after verifying the product currency in Odoo.
ODOO_CURRENCY=


# --- Storage ----------------------------------------------------------------
# Local development uses SQLite under ./data; leave DB_PATH empty for the default.
DB_PATH=

# Deployment runs on Firebase. Firestore holds each restaurant's state and
# Firebase Auth holds the staff accounts, so no separate database URL is needed.
# Credentials come from the ambient service account (GOOGLE_APPLICATION_CREDENTIALS
# locally, or the runtime's own identity on Google Cloud).
FIREBASE_PROJECT_ID=resuto-cf8f5
# Set to true to serve every request through Firestore tenant isolation.
FIREBASE_TENANT_MODE=true
