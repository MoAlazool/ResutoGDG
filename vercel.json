{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'no dependencies needed for the static landing page'",
  "buildCommand": "node scripts/build-static-landing.mjs",
  "outputDirectory": "dist-landing",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/public", "destination": "/data/public.json" },
    { "source": "/api/plans", "destination": "/data/plans.json" },
    { "source": "/api/integration-capabilities", "destination": "/data/capabilities.json" },
    { "source": "/qr/:token", "destination": "/data/qr.svg" }
  ],
  "redirects": [
    { "source": "/:page(restaurant|reserve|menu|pricing|account|kitchen|host|order)", "destination": "https://resutogdg.onrender.com/:page", "permanent": false },
    { "source": "/:area(manager|burger|t|s)/:rest*", "destination": "https://resutogdg.onrender.com/:area/:rest*", "permanent": false },
    { "source": "/:area(manager|burger)", "destination": "https://resutogdg.onrender.com/:area", "permanent": false }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'none'" }
    ] },
    { "source": "/(fonts|assets)/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] }
  ]
}
