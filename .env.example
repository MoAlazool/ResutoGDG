# Resuto 2.0 — environment template. Copy to .env and fill in what you have.
# Never commit real values. Each environment (dev/staging/prod) has its own.

# --- API (apps/api) ---------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgres://postgres@127.0.0.1:54329/resuto

# Supabase Auth: set SUPABASE_URL (+ JWT secret for HS256 projects).
SUPABASE_URL=
SUPABASE_JWT_SECRET=dev-only-jwt-secret-change-me-at-least-32-chars
SUPABASE_SERVICE_ROLE_KEY=
# Local only: email/password issuer that mints Supabase-shaped JWTs. Refused in production.
AUTH_DEV_MODE=true

# Credential encryption keys: "<id>:<base64 32 bytes>[,<old id>:<old key>]".
# Generate: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEYS=

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.local/storage

# Payments: sandbox = simulated provider + provider sandboxes only.
PAYMENT_MODE=sandbox

# Native AI
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# WhatsApp Cloud API (per-platform app; merchant numbers are connected per tenant)
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Ad platforms: Resuto's developer apps used for merchant OAuth (merchants connect their own ad accounts)
META_APP_ID=
META_APP_SECRET=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=

# AI service shared token (min 16 characters); the service refuses to start without one

# --- MCP server (apps/mcp-server) -------------------------------------------
# See apps/mcp-server/README.md for every option.
RESUTO_API_URL=http://localhost:4000
MCP_HOST=127.0.0.1
MCP_PORT=7100
MCP_PUBLIC_URL=
# Opt-in secret-URL mode for connectors that cannot send headers (see README risks).
MCP_ALLOW_URL_KEY=false
MCP_INTERNAL_TOKEN=

# --- Web (apps/web) ---------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public HTTPS URL of the MCP server, shown on the AI connections page.
NEXT_PUBLIC_MCP_URL=http://localhost:7100/mcp
