# Resuto 2.0 — environment template. Copy to .env and fill in what you have.
# Never commit real values. Each environment (dev/staging/prod) has its own.

# --- API (apps/api) ---------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
# Which X-Forwarded-For hop is the client (rate limits, access log): unset = 1 hop in staging/production
# (Render's load balancer), loopback locally; "false" when the API is reached directly; or proxy CIDRs.
TRUST_PROXY=
DATABASE_URL=postgres://postgres@127.0.0.1:54329/resuto

# Supabase Auth: set SUPABASE_URL (+ JWT secret for HS256 projects).
SUPABASE_URL=
SUPABASE_JWT_SECRET=dev-only-jwt-secret-change-me-at-least-32-chars
SUPABASE_SERVICE_ROLE_KEY=
# Local only: email/password issuer that mints Supabase-shaped JWTs. Refused in production.
AUTH_DEV_MODE=true

# Credential encryption keys: "<id>:<base64 32 bytes>[,<old id>:<old key>]".
# Generate: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEYS=
# Optional master(s) for purpose-bound HMAC keys (media URLs, delivery codes), comma-separated newest first, 32+ chars
# each; unset = derived from CREDENTIALS_KEYS. Older entries and CREDENTIALS_KEYS entries keep verifying.
SIGNING_KEY=
# Only for Supabase projects on the legacy JWT secret: accept HS256 next to the project's JWKS.
AUTH_ALLOW_HS256=false

# local | supabase. Staging/production must set it explicitly; production refuses local.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.local/storage

# ResutoStudio custom domains. Manual mode (default) never marks a domain active by itself.
DOMAIN_PROVIDER=manual
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# DNS targets shown to restaurants when they connect a domain
DOMAIN_CNAME_TARGET=cname.resuto.app
DOMAIN_A_RECORD=
# Hostnames that are never accepted as restaurant domains (comma-separated suffixes)
RESERVED_HOST_SUFFIXES=resuto.app,localhost

# Payments: sandbox = simulated provider + provider sandboxes only (anyone with a link can "pay").
# Staging/production must set it explicitly; production refuses sandbox.
PAYMENT_MODE=sandbox

# Connect sandbox channels + inbound simulator: default on outside production; production refuses them.
# CONNECT_SANDBOX=false

# Native AI
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# WhatsApp Cloud API (per-platform app; merchant numbers are connected per tenant)
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Ad platforms: Resuto's developer apps used for merchant OAuth (merchants connect their own ad accounts)
META_APP_ID=
META_APP_SECRET=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=

# AI service shared token (min 16 characters); the service refuses to start without one

# --- MCP server (apps/mcp-server) -------------------------------------------
# See apps/mcp-server/README.md for every option.
RESUTO_API_URL=http://localhost:4000
MCP_HOST=127.0.0.1
MCP_PORT=7100
MCP_PUBLIC_URL=
# Opt-in secret-URL mode for connectors that cannot send headers (see README risks).
MCP_ALLOW_URL_KEY=false

# --- Web (apps/web) ---------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public origin of the web app (QR links, sitemaps) and the demo restaurant on the landing page
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_DEMO_SLUG=the-olive-room
# Server-side API URL for the Next.js server/middleware (inside a private network if available)
API_INTERNAL_URL=http://localhost:4000
# Hosts that serve the Resuto app itself; any other Host is resolved as a restaurant custom domain
APP_HOSTS=localhost,127.0.0.1
# Public HTTPS URL of the MCP server, shown on the AI connections page.
NEXT_PUBLIC_MCP_URL=http://localhost:7100/mcp
