{
  "name": "resuto",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "Resuto 2.0 — AI-native restaurant operating system (modular monolith monorepo)",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "bash scripts/db/local-up.sh",
    "db:down": "bash scripts/db/local-down.sh",
    "db:migrate": "node scripts/db/migrate.mjs",
    "db:reset": "node scripts/db/migrate.mjs --reset && node scripts/db/seed.mjs",
    "db:seed": "node scripts/db/seed.mjs",
    "db:test": "node --test supabase/tests/*.test.mjs",
    "legacy:start": "npm --prefix legacy start",
    "legacy:test": "npm --prefix legacy test",
    "e2e": "playwright test -c tests/e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "pg": "8.16.3",
    "turbo": "2.5.8",
    "typescript": "5.9.3"
  }
}
