{
  "name": "@resuto/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "ResutoMCP server: exposes a restaurant's Resuto tools to external AI clients over MCP (Streamable HTTP and stdio). Holds no database access; every call is forwarded to the Resuto API with the client's rmcp_ key.",
  "type": "module",
  "main": "dist/main.js",
  "bin": { "resuto-mcp": "dist/main.js" },
  "engines": { "node": ">=22.12" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "start:stdio": "node dist/main.js --stdio",
    "test": "tsc -p tsconfig.json && vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "pg": "8.16.3",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
